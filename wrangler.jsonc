{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halovera-command",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "halovera-command-db",
      "database_id": "3425e88e-bf86-41c5-a584-0edf21de67f3"
    }
  ],
  "observability": {
    "enabled": true
  }
}
